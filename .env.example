# Copy to .env and fill in. Only SECRET_KEY and DATABASE_URL are required.

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL (docker compose exposes it on localhost:5432) ...
DATABASE_URL=postgresql+psycopg://focusbuddy:focusbuddy_pass@localhost:5432/focusbuddy
# ... or zero-setup SQLite for a quick local run:
# DATABASE_URL=sqlite:///focusbuddy.db

# Set to 1 behind HTTPS in production
COOKIE_SECURE=0

# Optional: FocusBot AI assistant (https://console.groq.com)
GROQ_API_KEY=

# Optional: verification / password-reset emails (https://resend.com)
# Without it, emails are skipped; new users can't verify, so seed demo data instead.
RESEND_API_KEY=
